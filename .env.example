# Required. Paste the external PostgreSQL provider's connection string.
# Preserve its SSL/TLS query parameters; URL-encode special password characters.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Required. Choose a long random password for /admin.html.
ADMIN_PASSWORD=replace-with-your-own-long-random-password
# Optional. Render supplies PORT and its default public URL automatically.
PORT=3000
# PUBLIC_ORIGIN=https://your-domain.example
